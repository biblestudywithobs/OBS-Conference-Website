# Copy to .env.local and fill in. Never commit real values.
RESEND_API_KEY=
RESEND_FROM="OBS Conference <hello@your-verified-domain>"
RESEND_TEAM_INBOX=

# Registrations (seat numbers, one registration per email/phone, attempt limits).
# Supabase project URL and its secret (service_role) key. Server only: never prefix with NEXT_PUBLIC_.
# Run supabase/conference_registrations.sql once in the project's SQL editor first.
# Without these the live site refuses registrations; in development they go to .data/registrations.json.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
