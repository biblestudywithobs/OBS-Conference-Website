# Copy to .env.local and fill in. Never commit real values.
RESEND_API_KEY=
RESEND_FROM="OBS Conference <hello@your-verified-domain>"
RESEND_TEAM_INBOX=

# Registrations (seat numbers, one registration per email/phone, attempt limits).
# Any Redis with a REST API, e.g. Upstash. Without these the live site refuses registrations;
# in development registrations go to .data/registrations.json instead.
REDIS_REST_URL=
REDIS_REST_TOKEN=
